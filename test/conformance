#!/usr/bin/env bash
# 두 구현이 docs/cli.md 의 계약을 똑같이 지키는지 본다.
#
# 소리는 비교할 수 없으므로 --plan 이 찍는 해석 결과를 비교한다. OS 와 무관해야
# 하는 필드는 완전히 같아야 하고, backend_* 는 계약의 환산식대로 나와야 한다.
# 한쪽 구현만 있는 기계에서는 그쪽만 돌리고 비교는 건너뛴다.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
BASH_IMPL=bin/nautice
PS_IMPL=bin/nautice.ps1

# OS 와 무관하게 같아야 하는 필드. voice 와 backend_* 는 플랫폼마다 다르다.
SHARED_FIELDS='^(command|voice_req|vol|rate|repeat|gap|tone|channel|hold|text|lang)='

pass=0 fail=0
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; shift; printf '       %s\n' "$@"; fail=$((fail + 1)); }

have_bash=0; [[ -x $BASH_IMPL ]] && have_bash=1
SKIP_WHY='구현 하나만 있다'
# Git Bash·MSYS 에서 bin/nautice 는 자기가 일하지 않고 nautice.ps1 로 넘긴다.
# 그대로 두면 ps1 을 양쪽에 대고 비교해 계획 케이스가 공허하게 다 통과하고,
# 환산식은 macOS·Linux 기대값(배속×175)에 SAPI 값을 대서 없는 실패를 낸다.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    have_bash=0
    SKIP_WHY='윈도다 — bin/nautice 가 ps1 로 넘기므로 비교할 상대가 없다' ;;
esac
have_ps=0
PWSH=""
if command -v pwsh >/dev/null 2>&1; then PWSH=pwsh
elif command -v powershell >/dev/null 2>&1; then PWSH=powershell
elif command -v nix >/dev/null 2>&1 && [[ ${NAUTICE_TEST_NIX_PWSH:-1} == 1 ]]; then
  # 개발 기계에 pwsh 가 없어도 nix 가 있으면 빌려 쓴다.
  nix shell nixpkgs#powershell -c pwsh -NoProfile -Command 'exit 0' >/dev/null 2>&1 \
    && PWSH="nix-pwsh"
fi
[[ -n $PWSH && -f $PS_IMPL ]] && have_ps=1

run_bash() { "$BASH_IMPL" "$@" 2>&1; }
run_ps() {
  case $PWSH in
    nix-pwsh) nix shell nixpkgs#powershell -c pwsh -NoProfile -File "$PS_IMPL" "$@" 2>&1 ;;
    *)        "$PWSH" -NoProfile -File "$PS_IMPL" "$@" 2>&1 ;;
  esac
}

echo "적합성 — bash=$have_bash ps=$have_ps${PWSH:+ ($PWSH)}"
echo

# ── 계획 비교 ───────────────────────────────────────────────────────────────
echo "계획 (OS 무관 필드가 같은가)"
# --plan 은 케이스 인자보다 **앞**에 둔다. 뒤에 붙이면 `--` 를 쓰는 케이스에서
# 문구로 먹혀(계약대로다) 소리가 실제로 나고, 양쪽 다 계획을 안 찍어 빈 문자열
# 끼리 비교하느라 공허하게 통과한다.
plan_case() {
  local name=$1; shift
  if (( have_bash == 0 || have_ps == 0 )); then
    printf '  \033[33mskip\033[0m %s (%s)\n' "$name" "$SKIP_WHY"; return
  fi
  local a b
  a=$(run_bash --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  b=$(run_ps   --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  if [[ -z $a || -z $b ]]; then
    bad "$name" "계획이 안 나왔다 (bash ${#a}자, ps ${#b}자)"
  elif [[ $a == "$b" ]]; then ok "$name"
  else bad "$name" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
}

plan_case 'say 기본'            say "테스트 문구"
plan_case 'say 볼륨/배속'       say -V 0.4 -r 1.5 "테스트 문구"
plan_case 'say 보이스 지정'     say -v Heami "테스트 문구"
plan_case 'play 이름표'         play ok
plan_case 'play 반복'           play -n 3 -g 0.25 notify
plan_case 'alert 톤 지정'       alert -t warn "디스크가 찼습니다"
plan_case 'call 기본 2회'       call
plan_case 'call 문구 지정'      call "확인 바랍니다"
plan_case 'call 반복 덮어쓰기'  call -n 1 "한 번만"
plan_case '-- 뒤는 전부 문구'   say -- "-v 처럼 보이는 문구"
# 언어 판정 — lang 이 갈라지면 같은 문구가 OS 마다 다른 보이스로 나간다.
plan_case '한글이면 ko'         say "빌드가 끝났습니다"
plan_case '영어면 en'           say "build finished"
# 악센트 붙은 라틴 문자는 UTF-8 에서 C3 로 시작한다. 앞 글자가 n(6E)·.(2E) 처럼
# e 로 끝나는 바이트면 hex 를 붙여 볼 때 ec 가 생겨 한국어로 넘어가던 자리다.
plan_case '악센트 라틴은 en'    say "Renée finished the nüance"
plan_case '섞이면 ko'           say "build 가 끝났습니다"
# 채널 — 배너를 낼지 소리를 낼지는 OS 와 무관하게 같아야 한다.
plan_case 'channel 기본 sound'  say "테스트 문구"
plan_case 'channel visual'      say -c visual "테스트 문구"
plan_case 'channel both'        alert -c both -t warn "디스크가 찼습니다"
plan_case 'channel call both'   call --channel both
plan_case 'hold 기본 꺼짐'      say -c visual "테스트 문구"
plan_case 'hold 켜짐'           say -c visual --hold "테스트 문구"
plan_case 'hold + both'         alert -c both --hold -t warn "디스크가 찼습니다"
# 배너가 없으면 붙잡을 것도 없다. 1 로 죽이지 않고 조용히 무시하는 것이 계약이다.
plan_case 'hold 는 sound 에서 무해' say --hold "테스트 문구"

# 문구를 인자가 아니라 파이프로 받는 자리. Windows 는 콘솔 코드페이지로 디코드
# 하면 한글이 쓰레기가 되므로 stdin 을 UTF-8 로 직접 읽는다 — 그게 살아 있는지
# 본다. 훅이 문구를 파이프로 넘기는 쓰임이 여기에 걸린다.
stdin_case() {
  local name=$1 text=$2; shift 2
  if (( have_bash == 0 || have_ps == 0 )); then
    printf '  \033[33mskip\033[0m %s (%s)\n' "$name" "$SKIP_WHY"; return
  fi
  local a b
  a=$(printf '%s' "$text" | run_bash --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  b=$(printf '%s' "$text" | run_ps   --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  if [[ -z $a || -z $b ]]; then
    bad "$name" "계획이 안 나왔다 (bash ${#a}자, ps ${#b}자)"
  elif [[ $a == "$b" ]]; then ok "$name"
  else bad "$name" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
}
stdin_case 'stdin 한글'         '빌드가 끝났습니다' say
stdin_case 'stdin 영어'         'build finished'    say
stdin_case 'stdin alert'        '디스크가 찼습니다' alert -t warn
echo

# ── 환산식 ──────────────────────────────────────────────────────────────────
echo "단위 환산 (docs/cli.md 의 식대로인가)"
# case 를 $( ) 안에 두지 않는다. macOS 의 /bin/bash 는 3.2 라 그 안의 ;; 를
# "syntax error near unexpected token" 으로 뱉는다 — 4.x 에서만 도는 문법이다.
check_rate() {
  local impl=$1 mult=$2 want=$3 got out
  if [[ $impl == bash ]]; then out=$(run_bash say --plan -r "$mult" x)
  else                        out=$(run_ps   say --plan -r "$mult" x)
  fi
  got=$(printf '%s\n' "$out" | sed -n 's/^backend_rate=//p')
  if [[ $got == "$want" ]]; then ok "$impl rate $mult -> $want"
  else bad "$impl rate $mult" "기대 $want, 실제 $got"; fi
}
if (( have_bash )); then
  # macOS·Linux: 배속 x 175 wpm
  for m in 0.5 1.0 1.5 2.0; do
    check_rate bash "$m" "$(awk -v m="$m" 'BEGIN { printf "%d", m * 175 }')"
  done
fi
if (( have_ps )); then
  # Windows: round(10 * log3(배속)), -10..10 으로 자름
  for m in 0.5 1.0 1.5 3.0; do
    check_rate ps "$m" "$(awk -v m="$m" 'BEGIN {
      r = 10 * log(m) / log(3)
      r = (r < 0) ? int(r - 0.5) : int(r + 0.5)
      if (r < -10) r = -10; if (r > 10) r = 10
      printf "%d", r }')"
  done
fi
echo

# ── 거부해야 하는 입력 ──────────────────────────────────────────────────────
echo "잘못된 입력은 양쪽 다 1 로, 제 문구로 죽는가"
# 종료코드만 보면 .NET 의 변환 예외 스택도 bash 의 unbound variable 도 통과한다 —
# 실제로 그렇게 새어 나간 적이 있다. 사용자가 본 첫 줄이 우리 문구인지까지 본다.
reject_case() {
  local name=$1; shift
  local why='' rc msg
  if (( have_bash )); then
    msg=$(run_bash "$@" | head -1); rc=${PIPESTATUS[0]}
    (( rc == 1 ))            || why+="bash 종료코드 $rc; "
    [[ $msg == nautice:* ]]  || why+="bash 문구 '${msg:-(없음)}'; "
  fi
  if (( have_ps )); then
    msg=$(run_ps "$@" | head -1); rc=${PIPESTATUS[0]}
    (( rc == 1 ))            || why+="ps 종료코드 $rc; "
    [[ $msg == nautice:* ]]  || why+="ps 문구 '${msg:-(없음)}'; "
  fi
  if [[ -n $why ]]; then bad "$name" "$why"; else ok "$name"; fi
}
reject_case '모르는 옵션'   say --bogus x
reject_case '모르는 명령'   bogus
reject_case 'cache 모르는 인자' cache bogus
reject_case 'list 모르는 인자'  list bogus
reject_case '없는 사운드'   play NoSuchSound
# --plan 이 해석을 건너뛰면 훅을 고치다 낸 오타를 여기서 못 잡는다.
reject_case '없는 사운드 --plan' play NoSuchSound --plan
reject_case '없는 톤'       alert -t NoSuchTone x
reject_case '모르는 채널'   say -c bogus x
# 효과음에는 문구가 없어 배너에 적을 것이 없다.
reject_case 'play 에 visual' play -c visual ok
reject_case 'play 에 both'   play -c both ok
reject_case '--repeat 범위' say -n 99 x
reject_case '--gap 범위'    say -g 99 x
reject_case '--rate 범위'   say -r 0 x
reject_case 'play 인자없음' play
# 값이 빠진 옵션과 숫자 아닌 값은 종료코드만 맞고 문구가 내부 오류였던 자리다.
reject_case '값 빠진 -v'    say -v
reject_case '값 빠진 -V'    say -V
reject_case '값 빠진 -r'    say -r
reject_case '값 빠진 -n'    say -n
reject_case '값 빠진 -g'    say -g
reject_case '값 빠진 -t'    say -t
reject_case '값 빠진 -c'    say -c
reject_case '--vol 문자'    say -V xyz x
reject_case '--rate 문자'   say -r abc x
reject_case '--repeat 문자' say -n q x
# 소수는 bash 가 산술 오류로, ps 가 반올림 재생으로 갈라지던 자리다.
reject_case '--repeat 소수' say -n 2.7 x
# 소수점이 쉼표인 문화권에서 조용히 0 으로 통과하던 자리다.
reject_case '--vol 쉼표'    say -V 0,4 x
reject_case '--vol 꼬리'    say -V 0.4abc x
echo

# ── 도움말이 계약의 옵션을 다 적고 있는가 ───────────────────────────────────
echo "도움말이 계약의 옵션을 다 적는가"
for opt in --voice --vol --rate --tone --channel --hold --repeat --gap --async --quiet; do
  miss=""
  (( have_bash )) && ! run_bash --help | grep -q -- "$opt" && miss="bash"
  (( have_ps ))   && ! run_ps   --help | grep -q -- "$opt" && miss="${miss:+$miss, }ps"
  if [[ -n $miss ]]; then bad "$opt" "빠진 곳: $miss"; else ok "$opt"; fi
done
echo

# ── doctor 와 list ──────────────────────────────────────────────────────────
echo "doctor 와 list 가 계약대로 말하는가"
# doctor 의 종료코드는 그 기계에 무엇이 깔렸느냐로 갈리므로 보지 않는다. 첫 줄은
# 버전과 어느 백엔드로 도는지를 밝히는 유일한 줄이라 모양이 고정돼야 한다.
doctor_head='^nautice [0-9]+\.[0-9]+\.[0-9]+ \((macos|linux|windows)\)$'
if (( have_bash )); then
  got=$(run_bash doctor | head -1)
  if [[ $got =~ $doctor_head ]]; then ok "bash doctor 머리글"
  else bad "bash doctor 머리글" "'$got'"; fi
fi
if (( have_ps )); then
  got=$(run_ps doctor | head -1)
  if [[ $got =~ $doctor_head ]]; then ok "ps doctor 머리글"
  else bad "ps doctor 머리글" "'$got'"; fi
fi
# 기본값 줄은 같은 숫자를 같은 서식으로 찍어야 한다. 이름표의 폭은 한글 너비
# 때문에 OS 마다 달라지므로 숫자 부분만 본다.
defaults_of() { sed -n 's/^.*\(vol=[0-9.]* rate=[0-9.]*\).*$/\1/p'; }
if (( have_bash && have_ps )); then
  a=$(run_bash doctor | defaults_of)
  b=$(run_ps   doctor | defaults_of)
  if [[ $a == "$b" && -n $a ]]; then ok "doctor 기본값 ($a)"
  else bad "doctor 기본값" "bash '$a' / ps '$b'"; fi
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "doctor 기본값" "$SKIP_WHY"
fi
# 번들 효과음의 이름표는 세 OS 가 같아야 한다 — 알림의 뜻이 기계마다 흔들리면
# 안 되기 때문이다. 그 뒤에 붙는 OS 기본 사운드는 기계마다 다르니 뺀다.
bundled() { sed -n '/^번들/,/^$/p' | sed -n 's/^  //p' | sort; }
if (( have_bash && have_ps )); then
  a=$(run_bash list sounds | bundled)
  b=$(run_ps   list sounds | bundled)
  if [[ $a == "$b" && -n $a ]]; then ok "list sounds 번들 이름표"
  else bad "list sounds 번들 이름표" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "list sounds 번들 이름표" "$SKIP_WHY"
fi
echo

# ── 버전 ────────────────────────────────────────────────────────────────────
# 버전이 세 곳에 따로 박혀 있다. 하나만 올리면 --version 과 nix 패키지가 갈라져
# 사용자가 어느 쪽을 쓰고 있는지 알 수 없게 된다. 파일에서 읽으므로 구현이
# 하나뿐인 기계에서도 세 값을 다 본다.
echo "버전이 세 곳에서 한 값인가"
v_nix=$(sed -n 's/.*version = "\([^"]*\)".*/\1/p' flake.nix | head -1)
v_bash=$(sed -n 's/^VERSION=//p' "$BASH_IMPL")
v_ps=$(tr -d '\r' < "$PS_IMPL" | sed -n "s/^\$VERSION = '\(.*\)'$/\1/p")
for pair in "flake.nix:$v_nix" "bin/nautice:$v_bash" "bin/nautice.ps1:$v_ps"; do
  where=${pair%%:*} got=${pair#*:}
  if [[ -z $got ]]; then bad "$where" "버전을 못 읽었다"
  elif [[ $got == "$v_nix" ]]; then ok "$where $got"
  else bad "$where" "flake.nix 는 $v_nix, $where 는 $got"; fi
done
# --version 이 실제로 그 값을 찍는지까지 본다.
if (( have_bash )); then
  got=$(run_bash --version)
  if [[ $got == "nautice $v_bash" ]]; then ok "bash --version"
  else bad "bash --version" "기대 'nautice $v_bash', 실제 '$got'"; fi
fi
if (( have_ps )); then
  got=$(run_ps --version)
  if [[ $got == "nautice $v_ps" ]]; then ok "ps --version"
  else bad "ps --version" "기대 'nautice $v_ps', 실제 '$got'"; fi
fi

# call 의 기본 문구는 계약에 글자 그대로 적혀 있다. 코드만 고치면 문서가 다른
# 문구를 약속한 채로 남는다 — 실제로 그렇게 갈라져 있던 자리다.
if (( have_bash || have_ps )); then
  # shellcheck disable=SC2016  # 찾는 게 마크다운의 백틱 자체다
  doc_call=$(sed -n 's/^.*기본 문구는 `\([^`]*\)`.*$/\1/p' docs/cli.md | head -1)
  if (( have_bash )); then got=$(run_bash call --plan | sed -n 's/^text=//p')
  else                      got=$(run_ps   call --plan | sed -n 's/^text=//p'); fi
  if [[ -n $doc_call && $doc_call == "$got" ]]; then ok "call 기본 문구 ($got)"
  else bad 'call 기본 문구' "docs/cli.md 는 '${doc_call:-(못 읽음)}', 구현은 '$got'"; fi
fi

# README 가 에이전트에게 주는 프롬프트는 옵션을 이름으로 부른다. 옵션이
# 바뀌면 그 프롬프트는 없는 옵션을 쓰라고 시키고, 에이전트가 그대로 설정을
# 고친 뒤에야 드러난다.
echo "README 의 에이전트 안내가 부르는 옵션이 있는가"
readme_opts=$(sed -n '/^## 에이전트에 물리기/,/^## 구조/p' README.md \
  | grep -oE '`--?[a-z][a-z-]*' | tr -d '`' | sort -u)
[[ -n $readme_opts ]] || bad 'README 안내' '옵션을 하나도 못 읽었다 (절 제목이 바뀌었나)'
for opt in $readme_opts; do
  miss=""
  (( have_bash )) && ! run_bash --help | grep -q -- "$opt" && miss="bash"
  (( have_ps ))   && ! run_ps   --help | grep -q -- "$opt" && miss="${miss:+$miss, }ps"
  if [[ -n $miss ]]; then bad "README $opt" "도움말에 없다: $miss"; else ok "README $opt"; fi
done
echo

# ── 계약의 효과음 이름표가 번들에 있는가 ────────────────────────────────────
# docs/cli.md 에 이름표만 더하고 tools/gen-sounds.py 를 안 돌리면 그 이름표는
# "그런 사운드가 없다" 로 죽는다. 반대로 파일만 늘면 아무도 그 소리를 못 찾는다.
echo "계약의 이름표와 번들 파일이 맞는가"
# shellcheck disable=SC2016  # 찾는 게 마크다운의 백틱 자체다
doc_tones=$(grep -F 'share/sounds/<이름>.wav' docs/cli.md | grep -oE '`[a-z]+`' | tr -d '`' | sort)
wav_tones=$(find share/sounds -name '*.wav' -exec basename {} .wav \; | sort)
if [[ $doc_tones == "$wav_tones" && -n $doc_tones ]]; then
  ok "$(printf '%s' "$doc_tones" | tr '\n' ' ')"
else
  bad '이름표' "$(diff <(printf '%s\n' "$doc_tones") <(printf '%s\n' "$wav_tones") | head -8)"
fi
echo

# ── 계약이 구현의 환경변수를 다 적고 있는가 ─────────────────────────────────
# 한쪽에만 적힌 변수는 아무도 못 찾는다. 파일만 읽으므로 구현이 하나뿐인
# 기계에서도 돈다.
echo "계약이 환경변수를 다 적는가"
impl_envs=$(grep -ohE 'NAUTICE_[A-Z_]+' "$BASH_IMPL" "$PS_IMPL" | sort -u)
doc_envs=$(grep -ohE 'NAUTICE_[A-Z_]+' docs/cli.md | sort -u)
for v in $impl_envs; do
  if grep -qF "$v" docs/cli.md; then ok "$v"; else bad "$v" "구현이 읽는데 docs/cli.md 에 없다"; fi
done
for v in $doc_envs; do
  printf '%s\n' "$impl_envs" | grep -qxF "$v" \
    || bad "$v" "docs/cli.md 에 있는데 어느 구현도 안 읽는다"
done
echo

printf '%d 통과, %d 실패\n' "$pass" "$fail"
(( fail == 0 ))
