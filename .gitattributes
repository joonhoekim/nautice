# Pin CRLF for Windows scripts and LF for POSIX ones. *.ps1 must also keep its
# UTF-8 BOM, or PowerShell 5.1 reads it in the system code page.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
bin/nautice text eol=lf
test/*      text eol=lf
*.md        text eol=lf
*.nix       text eol=lf
*.py        text eol=lf
install.sh  text eol=lf
tools/*     text eol=lf
*.wav       binary
