#!/usr/bin/env bash
# nautice — a notification CLI that lets an agent get a human's attention (macOS, Linux).
# The Windows implementation is bin/nautice.ps1. docs/cli.md is the contract for both.
set -euo pipefail

# With a comma decimal mark, printf '%.3f' 0.4 fails and prints 0,000 (de_DE,
# fr_FR). LC_ALL would override LC_NUMERIC, so move it into LC_CTYPE first.
if [[ -n ${LC_ALL:-} ]]; then export LC_CTYPE="$LC_ALL"; unset LC_ALL; fi
export LC_NUMERIC=C

VERSION=0.4.1

: "${NAUTICE_CACHE:=${XDG_CACHE_HOME:-$HOME/.cache}/nautice}"
: "${NAUTICE_VOICE:=auto}"
: "${NAUTICE_LANG:=auto}"
: "${NAUTICE_VOL:=0.6}"
: "${NAUTICE_RATE:=1.0}"
: "${NAUTICE_PIPER_MODEL:=}"
: "${NAUTICE_CHANNEL:=sound}"
: "${NAUTICE_PREROLL:=0.25}"
# Neutral on purpose: the tool is not tied to any agent. Users can name theirs.
: "${NAUTICE_CALL_MESSAGE:=Your agent is calling}"

# Normal speed for say and espeak-ng, i.e. rate 1.0. On macOS `say -r 175` and
# say without -r produce the same duration (Yuna Premium, 2.53 s).
BASE_WPM=175
# Data lives per version; the lock stays shared so playback is serialised
# even while two versions coexist during an upgrade.
CACHE_DIR="$NAUTICE_CACHE/$VERSION"
LOCK="$NAUTICE_CACHE/.lock"
LOCK_TIMEOUT=30

die() { printf 'nautice: %s\n' "$*" >&2; exit 1; }

# sha1sum first: shasum is a perl script, 14 ms a run against 1 ms, and prints
# ~20 lines of "Setting locale failed" whenever LANG names a locale that is not
# installed (common in containers). Both print the same hash, so cache keys
# survive the switch. macOS has only shasum; minimal Linux only sha1sum.
hash_stdin() {
  if   command -v sha1sum >/dev/null 2>&1; then sha1sum
  elif command -v shasum  >/dev/null 2>&1; then shasum
  elif command -v md5sum  >/dev/null 2>&1; then md5sum
  else die "no hash tool (need sha1sum, shasum or md5sum)"
  fi
}
say_status() { [[ $OPT_QUIET == 1 ]] || printf 'nautice: %s\n' "$*"; }

# ── Locating bundled sounds ─────────────────────────────────────────────────
# The layout differs between a checkout and an installed prefix. Symlinks must
# be followed, or a nix profile's bin/nautice cannot find share/.
script_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [[ -L $src ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ $src != /* ]] && src=$dir/$src
  done
  cd -P "$(dirname "$src")" && pwd
}

# Git Bash / MSYS land here; hand over to the Windows implementation so one
# name works everywhere. WSL reports Linux and stays.
case "$(uname -s)" in
  Darwin) PLATFORM=macos ;;
  Linux)  PLATFORM=linux ;;
  MINGW*|MSYS*|CYGWIN*)
    exec powershell -NoProfile -ExecutionPolicy Bypass \
      -File "$(script_dir)/nautice.ps1" "$@" ;;
  *) die "this script is for macOS and Linux ($(uname -s)); on Windows use nautice.ps1" ;;
esac

find_sounds() {
  [[ -n ${NAUTICE_SOUNDS:-} ]] && { printf '%s' "$NAUTICE_SOUNDS"; return; }
  local d; d=$(script_dir)
  local c
  for c in "$d/../share/sounds" "$d/../share/nautice/sounds"; do
    [[ -d $c ]] && { cd -P "$c" && pwd; return; }
  done
  die "bundled sounds not found; set NAUTICE_SOUNDS"
}

# ── Audio playback ──────────────────────────────────────────────────────────
# Each player takes volume in its own unit. aplay takes none and silently plays
# at system volume, which is why doctor names the player in use.
linux_player() {
  local p
  for p in pw-play paplay aplay ffplay mpv; do
    command -v "$p" >/dev/null 2>&1 && { printf '%s' "$p"; return; }
  done
  return 1
}

# afplay spends ~0.95 s just starting up (1.38 s to play a 0.43 s file, 3 runs,
# macOS 26 / Apple silicon) — longer than a short chime. Hooks detach with
# --async so it is not felt there, but every --repeat adds it again.
audio_play() {
  local file=$1 vol=${OPT_VOL:-$NAUTICE_VOL}
  if [[ $PLATFORM == macos ]]; then
    afplay -v "$vol" "$file"
    return
  fi
  local p; p=$(linux_player) || die "no audio player (need pw-play, paplay, aplay, ffplay or mpv)"
  case $p in
    pw-play) pw-play --volume="$vol" "$file" ;;
    paplay)  paplay --volume="$(awk -v v="$vol" 'BEGIN{printf "%d", v*65536}')" "$file" ;;
    aplay)   aplay -q "$file" ;;
    ffplay)  ffplay -nodisp -autoexit -loglevel quiet -volume \
               "$(awk -v v="$vol" 'BEGIN{printf "%d", v*100}')" "$file" ;;
    mpv)     mpv --really-quiet --volume="$(awk -v v="$vol" 'BEGIN{printf "%d", v*100}')" "$file" ;;
  esac
}

# ── Visual channel (banner) ─────────────────────────────────────────────────
# Exit 0 only means the backend was called. osascript returns 0 without
# notification permission or under Focus, and notify-send does when the daemon
# drops the message. See "Platform differences" in docs/cli.md.
visual_backend() {
  case $PLATFORM in
    macos) printf 'osascript' ;;
    linux) printf 'notify-send' ;;
  esac
}

banner_show() {
  local text=$1 b; b=$(visual_backend)
  command -v "$b" >/dev/null 2>&1 \
    || die "$b not found (needed for the visual channel)"
  case $PLATFORM in
    macos)
      # Pass the text through argv instead of splicing it into an AppleScript
      # string literal, which would need quotes and backslashes escaped.
      #
      # --hold is a no-op here: banner vs. persistent alert is a per-app user
      # setting (System Settings > Notifications) that scripts cannot change.
      osascript - "$text" nautice <<'AS' >/dev/null
on run argv
  display notification (item 1 of argv) with title (item 2 of argv)
end run
AS
      ;;
    # -t 0 means "never expire", but it is only a hint; GNOME Shell ignores it.
    linux)
      if [[ $OPT_HOLD == 1 ]]; then notify-send -t 0 -- nautice "$text"
      else                          notify-send -- nautice "$text"; fi ;;
  esac
}

# Banners ignore --repeat: copies piling up in the notification center are noise.
maybe_banner() {
  [[ $CHANNEL == sound ]] && return 0
  banner_show "$1"
}

# Suffix for the status line when a banner was shown too.
chan_note() { [[ $CHANNEL == sound ]] || printf ' +banner'; }

# ── Language detection ──────────────────────────────────────────────────────
# Read UTF-8 bytes, not regex ranges like [가-힣]: with LC_CTYPE=C (cron,
# containers) such a range matches everything, and under en_US collation a
# range spanning jamo dies with "invalid character range".
# One byte per line — a joined hex string lets "Renée" (6e c3) show a false
# "ec". Two bytes are checked so ranges match docs/cli.md exactly. Hex is
# compared as strings: BSD awk has no strtonum.
detect_lang() {
  printf '%s' "$1" | od -An -tx1 -v | tr ' ' '\n' | grep -v '^$' | awk '
    { n++; h[n] = $1 }
    END {
      for (i = 1; i <= n; i++) {
        a = h[i]; b = (i < n) ? h[i + 1] : "00"
        if ((a == "ea" && b >= "b0") || a == "eb" || a == "ec" || (a == "ed" && b <= "9e")) ko = 1
        else if (a == "e3" && b >= "81" && b <= "83") ja = 1
        else if ((a == "e4" && b >= "b8") || (a >= "e5" && a <= "e9")) zh = 1
        else if (a >= "d0" && a <= "d3") ru = 1
        else if ((a == "cd" && b >= "b0") || a == "ce" || a == "cf") el = 1
        else if (a >= "d8" && a <= "db") ar = 1
        else if ((a == "d6" && b >= "90") || a == "d7") he = 1
        else if (a == "e0" && b >= "b8" && b <= "b9") th = 1
        else if (a == "e0" && b >= "a4" && b <= "a5") hi = 1
      }
      # Mixed text: first in this order wins (same order as docs/cli.md).
      if (ko) print "ko"; else if (ja) print "ja"; else if (zh) print "zh"
      else if (ru) print "ru"; else if (el) print "el"; else if (ar) print "ar"
      else if (he) print "he"; else if (th) print "th"; else if (hi) print "hi"
      else print ""
    }'
}

# Latin-script languages. The locale decides the language of Latin text only
# when it is one of these, so a Korean locale does not read English in Korean.
LATIN_LANGS=" af ca cs cy da de en es et eu fi fr ga gl hr hu id is it lt lv ms nb nl nn no pl pt ro sk sl sq sv sw tl tr vi "

# Two-letter language from the locale; often absent (cron, systemd, containers).
locale_lang() {
  local l=${LC_MESSAGES:-${LANG:-}}
  l=${l%%.*}; l=${l%%_*}; l=${l%%@*}
  [[ $l =~ ^[a-z]{2}$ ]] || return 1
  printf '%s' "$l"
}

resolve_lang() {
  local text=$1 l=${OPT_LANG:-$NAUTICE_LANG}
  if [[ $l != auto ]]; then printf '%s' "$l"; return; fi
  l=$(detect_lang "$text")
  if [[ -n $l ]]; then printf '%s' "$l"; return; fi
  # Latin script: the text cannot tell, so fall back to the locale.
  l=$(locale_lang) || l=''
  if [[ -n $l && $LATIN_LANGS == *" $l "* ]]; then printf '%s' "$l"; else printf 'en'; fi
}

# ── Voices ──────────────────────────────────────────────────────────────────
# `say -v '?'` takes 0.5 s, so it runs once and is cached as "name<TAB>lang".
# Names contain spaces and parentheses (`Eddy (Korean (South Korea))`); the
# locale code (ko_KR, ar_001) is the only reliable end-of-name marker.
voice_table() {
  local f="$CACHE_DIR/.voices"
  # Without espeak-ng there are no voices, whatever a run with it cached (a nix
  # wrapper and a plain install share the cache).
  if [[ $PLATFORM == linux ]] && ! command -v espeak-ng >/dev/null 2>&1; then return 0; fi
  if [[ ! -s $f ]]; then
    mkdir -p "$CACHE_DIR"
    case $PLATFORM in
      macos)
        say -v '?' \
          | sed -E -n 's/^(.*[^[:space:]])[[:space:]]+([a-z]{2})_[A-Z0-9]{2,3}[[:space:]]+#.*$/\1\t\2/p' \
          > "$f" ;;
      linux)
        # espeak-ng --voices columns: Pty Language Age/Gender VoiceName File Other.
        # The name is the Language column: -v rejects VoiceName once it has
        # "(" (Chinese_(Cantonese)), and matches case-sensitively, so the one
        # mixed-case id (chr-US-Qaaa-x-west) gives way to its File (iro/chr).
        # Other lists aliases as "(zh 5)": Chinese is listed only as cmn and
        # yue, yet -v zh works, so aliases count as languages too.
        espeak-ng --voices 2>/dev/null | awk 'NR > 1 {
            n = ($2 ~ /[A-Z]/) ? $5 : $2; c = $2; sub(/-.*/, "", c); print n "\t" c
            s = $0
            while (match(s, /\([a-z]+(-[a-z0-9]+)* [0-9]+\)/)) {
              a = substr(s, RSTART + 1, RLENGTH - 2); sub(/ .*/, "", a); sub(/-.*/, "", a)
              if (a != c) print n "\t" a
              s = substr(s, RSTART + RLENGTH)
            }
          }' | awk '!seen[$0]++' > "$f" ;;
    esac
  fi
  cat "$f"
}

voice_list() { voice_table | awk -F'\t' -v l="$1" '$2 == l { print $1 }'; }

# `say -v NoSuchVoice` exits 0 and quietly uses the default voice, so a typo
# would go unnoticed. Check the name ourselves.
voice_exists() { voice_table | cut -f1 | grep -qxF "$1"; }

# macOS's default voice per language. Without -v, say ignores the text's
# language (Japanese ends in 0.5 s vs 1.26 s with Kyoko); the first listed en
# voice is a novelty one (Albert). Without quality tiers this is the only cue.
default_voice_name() {
  case $1 in
    ko) printf Yuna ;;     ja) printf Kyoko ;;    zh) printf Tingting ;;
    en) printf Samantha ;; de) printf Anna ;;     fr) printf Thomas ;;
    es) printf Monica ;;   it) printf Alice ;;    pt) printf Luciana ;;
    ru) printf Milena ;;   ar) printf Majed ;;    he) printf Carmit ;;
    th) printf Kanya ;;    hi) printf Lekha ;;    el) printf Melina ;;
    tr) printf Yelda ;;    nl) printf Xander ;;   sv) printf Alva ;;
    da) printf Sara ;;     fi) printf Satu ;;     pl) printf Zosia ;;
    cs) printf Zuzana ;;   *)  printf '' ;;
  esac
}

# One voice for a language, or failure (the caller falls back). Quality voices
# are spotted only by their "(Premium)"/"(Enhanced)" suffix. Cached — run
# `nautice cache clear` after downloading voices.
best_voice() {
  local lang=$1 names v="" pat
  local f="$CACHE_DIR/.voice-$lang"
  if [[ -s $f ]]; then cat "$f"; return; fi
  local fb; fb=$(default_voice_name "$lang")
  names=$(voice_list "$lang") || true
  [[ -z ${names// } ]] && return 1
  for pat in "$fb (Premium)" "(Premium)" "$fb (Enhanced)" "(Enhanced)" "$fb"; do
    [[ -n $v ]] && break
    v=$(printf '%s\n' "$names" | grep -m1 -F "$pat" || true)
  done
  [[ -z $v ]] && v=$(printf '%s\n' "$names" | head -1)
  [[ -z ${v// } ]] && return 1
  mkdir -p "$CACHE_DIR"; printf '%s' "$v" > "$f"
  printf '%s' "$v"
}

# Per-language override such as NAUTICE_VOICE_KO. No ${v^^}: bash 3.2 lacks it.
lang_voice_env() {
  local n; n=$(printf 'NAUTICE_VOICE_%s' "$1" | tr '[:lower:]' '[:upper:]')
  eval "printf '%s' \"\${$n:-}\""
}

resolve_voice() {
  local lang=$1 v=${OPT_VOICE:-$NAUTICE_VOICE} named
  if [[ $v == auto ]]; then
    named=$(lang_voice_env "$lang")
    [[ -n $named ]] && v=$named || v=best
  fi
  # espeak-ng has no quality tiers and takes the language code as the voice.
  # It has no voice for some locales' languages (gl, tl): -v gl exits 1, and
  # under --async every notification is lost without a sound. Fall back to en
  # (docs/cli.md). An empty table means piper or no TTS; the code is kept then.
  if [[ $PLATFORM == linux ]]; then
    if [[ $v == best || $v == auto ]]; then
      v=$lang
      [[ -n $(voice_table) && -z $(voice_list "$lang") ]] && v=en
    fi
    printf '%s' "$v"; return
  fi
  if [[ $v == best ]]; then
    # No voice for the language: fall back rather than fail. A notification in
    # the wrong accent beats no notification (docs/cli.md).
    v=$(best_voice "$lang") || v=$(best_voice en) || v=$(voice_table | cut -f1 | head -1)
    [[ -z ${v// } ]] && die "no voices found (nautice list voices)"
    printf '%s' "$v"; return
  fi
  voice_exists "$v" || die "no such voice: $v (nautice list voices)"
  printf '%s' "$v"
}

# ── Lead-in silence ─────────────────────────────────────────────────────────
# An HDMI display dropped the first ~0.1 s of a sound after a quiet spell, and
# only silence in the same stream helped (docs/cli.md, "Lead-in silence"). So
# the silence is spliced into a copy of the WAV rather than played before it.
preroll_ms() { awk -v p="$NAUTICE_PREROLL" 'BEGIN { printf "%d", p * 1000 + 0.5 }'; }

# Four bytes, little-endian, as octal escapes: printf has no binary format.
le32() {
  local i fmt=''
  for i in 0 8 16 24; do fmt+=$(printf '\\%03o' $(($1 >> i & 255))); done
  # shellcheck disable=SC2059  # the format is nothing but those escapes
  printf "$fmt"
}

# "<data chunk offset> <data size> <RIFF size> <bytes of silence>", or nothing
# when silence is not zero bytes (8-bit PCM is unsigned) or the file is not WAV.
wav_layout() {
  od -An -tu1 -v -N 4096 "$1" | awk -v ms="$2" '
    function le(o, k,   v, j) { v = 0; for (j = k - 1; j >= 0; j--) v = v * 256 + b[o + j]; return v }
    function id(o) { return sprintf("%c%c%c%c", b[o], b[o + 1], b[o + 2], b[o + 3]) }
    { for (i = 1; i <= NF; i++) b[n++] = $i }
    END {
      if (n < 12 || id(0) != "RIFF" || id(8) != "WAVE") exit
      for (o = 12; o + 8 <= n; o += 8 + s + s % 2) {
        s = le(o + 4, 4)
        if (id(o) == "fmt ") { fmt = le(o + 8, 2); rate = le(o + 16, 4); align = le(o + 20, 2); bits = le(o + 22, 2) }
        if (id(o) != "data") continue
        # 1 PCM, 3 float, 65534 extensible. A streamed size (0, ~4 GiB) is unknown.
        if (align < 1 || bits <= 8 || (fmt != 1 && fmt != 3 && fmt != 65534)) exit
        if (s < 1 || s > 2147483647) exit
        printf "%d %d %d %d\n", o, s, le(4, 4), int(rate * ms / 1000 / align) * align
        exit
      }
    }'
}

# A copy of a WAV that starts with $2 ms of silence, cached by content; the file
# itself when that is not possible — a clipped sound beats no sound.
wav_lead() {
  local src=$1 ms=$2 out lay off size riff z
  (( ms > 0 )) || { printf '%s' "$src"; return; }
  out="$CACHE_DIR/$({ printf 'lead|%s|' "$ms"; cat "$src"; } | hash_stdin | cut -d' ' -f1).wav"
  if [[ ! -s $out ]]; then
    lay=$(wav_layout "$src" "$ms")
    [[ -n $lay ]] || { printf '%s' "$src"; return; }
    read -r off size riff z <<<"$lay"
    mkdir -p "$CACHE_DIR"
    # head before tail: tail | head would die of SIGPIPE under pipefail.
    { head -c 4 "$src"; le32 $((riff + z))
      head -c $((off + 4)) "$src" | tail -c +9; le32 $((size + z))
      head -c "$z" /dev/zero; tail -c +$((off + 9)) "$src"; } > "$out.tmp"
    mv -f "$out.tmp" "$out"
  fi
  printf '%s' "$out"
}

# ── TTS rendering ───────────────────────────────────────────────────────────
# Neither say nor espeak-ng takes a playback volume, so speech is rendered to a
# file and played by the audio player; caching the file skips re-synthesis.
wpm_for() { awk -v m="$1" -v b="$BASE_WPM" 'BEGIN { printf "%d", m * b }'; }

# $4 is the lead-in in ms. say writes AIFF, so on macOS the synthesiser adds it.
tts_render() {
  local voice=$1 rate=$2 text=$3 lead=$4 key path ext=aiff
  [[ $PLATFORM == linux ]] && ext=wav
  [[ $PLATFORM == macos ]] && (( lead > 0 )) && text="[[slnc $lead]] $text"
  key=$(printf '%s|%s|%s|%s' "$PLATFORM" "$voice" "$rate" "$text" | hash_stdin | cut -d' ' -f1)
  path="$CACHE_DIR/$key.$ext"
  if [[ ! -s $path ]]; then
    mkdir -p "$CACHE_DIR"
    case $PLATFORM in
      macos)
        say -v "$voice" -r "$(wpm_for "$rate")" -o "$path.tmp" -- "$text" \
          || die "say failed (voice '$voice')"
        mv -f "$path.tmp" "$path" ;;
      linux)
        if [[ -n $NAUTICE_PIPER_MODEL ]]; then
          command -v piper >/dev/null 2>&1 || die "NAUTICE_PIPER_MODEL is set but piper is not installed"
          printf '%s' "$text" | piper -m "$NAUTICE_PIPER_MODEL" -f "$path.tmp" >/dev/null 2>&1 \
            || die "piper failed (model: $NAUTICE_PIPER_MODEL)"
        elif command -v espeak-ng >/dev/null 2>&1; then
          espeak-ng -v "$voice" -s "$(wpm_for "$rate")" -w "$path.tmp" -- "$text" \
            || die "espeak-ng failed (voice '$voice')"
        else
          die "no TTS backend (install espeak-ng or set NAUTICE_PIPER_MODEL)"
        fi
        mv -f "$path.tmp" "$path" ;;
    esac
  fi
  [[ $PLATFORM == linux ]] && path=$(wav_lead "$path" "$lead")
  printf '%s' "$path"
}

# ── Sound resolution ────────────────────────────────────────────────────────
# Bundled sounds first, so a tone means the same thing on every OS.
sfx_resolve() {
  local name=$1 sounds
  [[ -f $name ]] && { printf '%s' "$name"; return; }
  sounds=$(find_sounds)
  [[ -f "$sounds/$name.wav" ]] && { printf '%s' "$sounds/$name.wav"; return; }
  if [[ $PLATFORM == macos && -f "/System/Library/Sounds/$name.aiff" ]]; then
    printf '%s' "/System/Library/Sounds/$name.aiff"; return
  fi
  die "no such sound: $name (nautice list sounds)"
}

# ── Cache pruning ───────────────────────────────────────────────────────────
# A cache belongs to one version: voice choices made by older logic would keep
# being used after an upgrade, silently. Remove only what nautice writes —
# NAUTICE_CACHE may point at a shared directory.
# With an argument, that version is kept; without one, everything goes
# (cache clear), and so does the directory if nothing else is left in it.
cache_prune() {
  [[ -d $NAUTICE_CACHE ]] || return 0
  local keep=${1:-} e name
  for e in "$NAUTICE_CACHE"/* "$NAUTICE_CACHE"/.voice* "$NAUTICE_CACHE"/.lock*; do
    [[ -e $e ]] || continue
    name=${e##*/}
    [[ -n $keep && $name == "$keep" ]] && continue
    if [[ -z $keep && ( $name == .lock || $name == .lock.d ) ]]; then rm -rf "$e"; continue; fi
    if [[ -d $e && $name =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then rm -rf "$e"
    elif [[ -f $e && ( $name == .voices || $name == .voice-* ) ]]; then rm -f "$e"
    elif [[ -f $e && $name =~ ^[0-9a-f]{32,40}\.(aiff|wav)$ ]]; then rm -f "$e"
    fi
  done
  [[ -n $keep ]] || rmdir "$NAUTICE_CACHE" 2>/dev/null || true
}

# ── Queue ───────────────────────────────────────────────────────────────────
# Overlapping playback garbles notifications, so playback (not rendering) is
# serialised. Without flock a mkdir lock is used; it outlives a killed process,
# so after LOCK_TIMEOUT we play anyway — overlap beats a lost notification.
with_lock() {
  mkdir -p "$NAUTICE_CACHE"
  if command -v flock >/dev/null 2>&1; then
    ( flock -w "$LOCK_TIMEOUT" 9 || true; "$@" ) 9>"$LOCK"
  else
    local d="$LOCK.d" waited=0
    while ! mkdir "$d" 2>/dev/null; do
      sleep 0.1; waited=$((waited + 1))
      (( waited > LOCK_TIMEOUT * 10 )) && break
    done
    trap 'rmdir "$d" 2>/dev/null || true' EXIT
    "$@"
    rmdir "$d" 2>/dev/null || true
    trap - EXIT
  fi
}

# ── Repetition ──────────────────────────────────────────────────────────────
# Repeat one unit (chime, speech, or both) --repeat times, all inside one lock
# so another notification cannot slip in between.
emit() {
  local chime=$1 speech=$2 i
  for (( i = 1; i <= OPT_REPEAT; i++ )); do
    [[ -n $chime  ]] && audio_play "$chime"
    [[ -n $speech ]] && audio_play "$speech"
    if (( i < OPT_REPEAT )); then
      awk -v g="$OPT_GAP" 'BEGIN { exit !(g > 0) }' && sleep "$OPT_GAP"
    fi
  done
  return 0
}

# The resolved plan, without sound, for test/conformance. Fields before
# backend= must match across OSes. voice cannot be compared, so lang is what
# exposes a divergence in language detection.
print_plan() {
  local cmd=$1 voice=$2 tone=$3 text=$4 lang
  lang=$(resolve_lang "$text")
  printf 'command=%s\n' "$cmd"
  printf 'voice_req=%s\n' "${OPT_VOICE:-$NAUTICE_VOICE}"
  printf 'voice=%s\n' "$voice"
  printf 'vol=%.3f\n' "${OPT_VOL:-$NAUTICE_VOL}"
  printf 'rate=%.3f\n' "${OPT_RATE:-$NAUTICE_RATE}"
  printf 'repeat=%d\n' "$OPT_REPEAT"
  printf 'gap=%.3f\n' "$OPT_GAP"
  printf 'tone=%s\n' "$tone"
  printf 'channel=%s\n' "$CHANNEL"
  printf 'hold=%s\n' "$OPT_HOLD"
  printf 'preroll=%.3f\n' "$NAUTICE_PREROLL"
  printf 'text=%s\n' "$text"
  printf 'lang=%s\n' "$lang"
  printf 'backend=%s\n' "$PLATFORM"
  printf 'backend_rate=%s\n' "$(wpm_for "${OPT_RATE:-$NAUTICE_RATE}")"
  printf 'backend_vol=%.3f\n' "${OPT_VOL:-$NAUTICE_VOL}"
  printf 'backend_visual=%s\n' "$(visual_backend)"
}

read_text() {
  local text=$*
  [[ -z $text && ! -t 0 ]] && text=$(cat)
  [[ -z ${text// } ]] && die "nothing to say"
  printf '%s' "$text"
}

# ── Commands ────────────────────────────────────────────────────────────────
cmd_say() {
  local text voice speech
  text=$(read_text "$@")
  if [[ $OPT_PLAN == 1 ]]; then
    voice=$(resolve_voice "$(resolve_lang "$text")" 2>/dev/null) || voice=''
    print_plan say "$voice" '' "$text"; return 0
  fi
  maybe_banner "$text"
  if [[ $CHANNEL == visual ]]; then say_status "say banner only"; return 0; fi
  voice=$(resolve_voice "$(resolve_lang "$text")")
  speech=$(tts_render "$voice" "${OPT_RATE:-$NAUTICE_RATE}" "$text" "$(preroll_ms)")
  say_status "say x$OPT_REPEAT [$voice]$(chan_note)"
  with_lock emit "" "$speech"
}

cmd_play() {
  local file
  [[ $# -gt 0 && -n ${1:-} ]] || die "need a sound name or path (nautice list sounds)"
  # A sound has no text to put in a banner.
  [[ $CHANNEL == sound ]] || die "play has no text for a banner (use --channel sound)"
  file=$(sfx_resolve "$1")
  [[ $OPT_PLAN == 1 ]] && { print_plan play '' "$1" ''; return 0; }
  file=$(wav_lead "$file" "$(preroll_ms)")
  say_status "play x$OPT_REPEAT [$1]"
  with_lock emit "$file" ""
}

cmd_alert() {
  local text voice speech chime
  : "${CMD_NAME:=alert}"
  text=$(read_text "$@")
  if [[ $OPT_PLAN == 1 ]]; then
    voice=$(resolve_voice "$(resolve_lang "$text")" 2>/dev/null) || voice=''
    print_plan "$CMD_NAME" "$voice" "${OPT_TONE:-ask}" "$text"; return 0
  fi
  maybe_banner "$text"
  if [[ $CHANNEL == visual ]]; then say_status "$CMD_NAME banner only"; return 0; fi
  voice=$(resolve_voice "$(resolve_lang "$text")")
  speech=$(tts_render "$voice" "${OPT_RATE:-$NAUTICE_RATE}" "$text" 0)
  chime=$(wav_lead "$(sfx_resolve "${OPT_TONE:-ask}")" "$(preroll_ms)")
  say_status "alert x$OPT_REPEAT [$voice]$(chan_note)"
  with_lock emit "$chime" "$speech"
}

cmd_call() {
  # Calling a human: once is easy to miss, so twice unless --repeat is given.
  [[ $REPEAT_GIVEN == 0 ]] && OPT_REPEAT=2
  CMD_NAME=call
  local text=$*
  # Keep it short: it is spoken twice, and a long one makes a call exceed 10 s.
  [[ -z ${text// } ]] && text=$NAUTICE_CALL_MESSAGE
  cmd_alert "$text"
}

cmd_list() {
  local what=${1:-all} sounds f lang
  sounds=$(find_sounds)
  case $what in
    sounds)
      echo "Bundled (all OSes):"
      for f in "$sounds"/*.wav; do printf '  %s\n' "$(basename "$f" .wav)"; done
      if [[ $PLATFORM == macos ]]; then
        echo; echo "macOS system sounds:"
        for f in /System/Library/Sounds/*.aiff; do printf '  %s\n' "$(basename "$f" .aiff)"; done
      fi ;;
    voices)
      for lang in $(voice_table | cut -f2 | sort -u); do
        printf '%s:\n' "$lang"
        voice_list "$lang" | sed 's/^/  /'
      done ;;
    all) cmd_list sounds; echo; cmd_list voices ;;
    *) die "list what: voices | sounds | all" ;;
  esac
}

cmd_doctor() {
  local ok=0 t p
  printf 'nautice %s (%s)\n\n' "$VERSION" "$PLATFORM"

  if [[ $PLATFORM == macos ]]; then
    for t in say afplay; do
      if command -v "$t" >/dev/null; then printf '  %-12s %s\n' "$t" "$(command -v "$t")"
      else printf '  %-12s missing (required)\n' "$t"; ok=1; fi
    done
  else
    if [[ -n $NAUTICE_PIPER_MODEL ]]; then
      printf '  %-12s %s\n' TTS "piper ($NAUTICE_PIPER_MODEL)"
      command -v piper >/dev/null || { printf '  %-12s piper is not on PATH\n' ''; ok=1; }
    elif command -v espeak-ng >/dev/null; then
      printf '  %-12s espeak-ng (formant synthesis; rough for some languages)\n' TTS
    else
      printf '  %-12s missing (need espeak-ng or NAUTICE_PIPER_MODEL)\n' TTS; ok=1
    fi
    if p=$(linux_player); then
      printf '  %-12s %s' player "$p"
      [[ $p == aplay ]] && printf ' (no volume control; --vol is ignored)'
      printf '\n'
    else
      printf '  %-12s missing (pw-play, paplay, aplay, ffplay or mpv)\n' player; ok=1
    fi
  fi

  local h=''
  for t in sha1sum shasum md5sum; do command -v "$t" >/dev/null && { h=$t; break; }; done
  if [[ -n $h ]]; then printf '  %-12s %s\n' hash "$(command -v "$h")"
  else printf '  %-12s missing (need sha1sum, shasum or md5sum)\n' hash; ok=1; fi

  if command -v flock >/dev/null; then printf '  %-12s %s\n' flock "$(command -v flock)"
  else printf '  %-12s missing (using a mkdir lock)\n' flock; fi

  # The visual channel is optional: a missing backend is reported, not failed.
  local vb; vb=$(visual_backend)
  if command -v "$vb" >/dev/null; then printf '  %-12s %s\n' banner "$(command -v "$vb")"
  else printf '  %-12s missing %s (no visual channel)\n' banner "$vb"; fi

  printf '  %-12s %s\n' sounds "$(find_sounds)"
  printf '  %-12s %s' cache "$NAUTICE_CACHE"
  if [[ -d $NAUTICE_CACHE ]]; then
    printf ' (%s files, %s)\n' \
      "$(find "$NAUTICE_CACHE" \( -name '*.aiff' -o -name '*.wav' \) | wc -l | tr -d ' ')" \
      "$(du -sh "$NAUTICE_CACHE" 2>/dev/null | cut -f1)"
  else printf ' (not created yet)\n'; fi
  # Same %.3f format as --plan; with %s, 1.0 prints as "1.0" here but "1" on Windows.
  printf '  %-12s vol=%.3f rate=%.3f\n' defaults "$NAUTICE_VOL" "$NAUTICE_RATE"
  # Languages with a voice. Others fall back silently under -q, so say it here.
  printf '  %-12s %s\n' languages "$(voice_table | cut -f2 | sort -u | tr '\n' ' ')"

  if [[ $PLATFORM == macos ]]; then
    # Built-in compact/eloquence voices are low quality. Premium/Enhanced ones
    # come from System Settings > Accessibility > Spoken Content > Manage Voices.
    local hi; hi=$(voice_table \
      | awk -F'\t' '$1 ~ /\((Premium|Enhanced)\)$/ { n[$2]++ } END { for (l in n) print l " " n[l] }' \
      | sort | paste -sd, - | sed 's/,/, /g')
    if [[ -n $hi ]]; then printf '  %-12s %s\n' quality "$hi"
    else printf '  %-12s none (System Settings > Accessibility > Spoken Content > Manage Voices)\n' quality; fi
  fi
  return $ok
}

cmd_cache() {
  case "${1:-info}" in
    clear) cache_prune; echo "cache cleared: $NAUTICE_CACHE (voice choices too)" ;;
    info)  if [[ -d $NAUTICE_CACHE ]]; then
             printf '%s  %s files  %s\n' "$NAUTICE_CACHE" \
               "$(find "$NAUTICE_CACHE" \( -name '*.aiff' -o -name '*.wav' \) | wc -l | tr -d ' ')" \
               "$(du -sh "$NAUTICE_CACHE" 2>/dev/null | cut -f1)"
           else echo "no cache: $NAUTICE_CACHE"; fi ;;
    *) die "cache what: info | clear" ;;
  esac
}

# Re-run the release's installer for this prefix; the install logic lives only
# in the installers (docs/cli.md, "Updating").
cmd_update() {
  local dir prefix tmp rc=0
  local url=https://github.com/joonhoekim/nautice/releases/latest/download/install.sh
  dir=$(script_dir)
  case $dir in
    /nix/store/*) die "installed with nix; update with: nix profile upgrade nautice" ;;
  esac
  prefix=$(cd -P "$dir/.." && pwd)
  [[ -d $prefix/share/nautice/sounds ]] \
    || die "not installed by install.sh ($prefix); update it the way it was installed"
  tmp=$(mktemp "${TMPDIR:-/tmp}/nautice-install.XXXXXX") || die "cannot create a temporary file"
  if command -v curl >/dev/null 2>&1; then curl -fsSL -o "$tmp" "$url" || rc=$?
  elif command -v wget >/dev/null 2>&1; then wget -qO "$tmp" "$url" || rc=$?
  else rm -f "$tmp"; die "neither curl nor wget found"
  fi
  (( rc == 0 )) || { rm -f "$tmp"; die "download failed: $url"; }
  NAUTICE_PREFIX=$prefix bash "$tmp" || rc=$?
  rm -f "$tmp"
  return $rc
}

usage() {
  cat <<'USAGE'
nautice — a notification CLI that lets an agent get a human's attention

Usage
  nautice say   [options] <text>        speak (stdin if omitted)
  nautice play  [options] <name|path>   play a sound
  nautice alert [options] <text>        play a sound, then speak
  nautice call  [options] [text]        call the human (alert + default text, twice)
  nautice list  [voices|sounds]         list voices or sounds
  nautice doctor                        check the environment
  nautice cache [info|clear]            render cache
  nautice update                        update this installation

Options
  -v, --voice NAME    voice (auto | best | name)
  -V, --vol N         0.0 to 1.0                (default 0.6)
  -r, --rate N        speed multiplier, 1.0 = normal (default 1.0)
  -t, --tone NAME     sound for alert/call      (default ask)
  -c, --channel NAME  sound | visual | both     (default sound)
  -l, --lang CODE     two-letter language code  (default auto: from the text)
      --hold          keep the banner until dismissed (visual channel only)
  -n, --repeat N      integer 1 to 20           (default 1, call 2)
  -g, --gap SEC       pause between repetitions (default 0.4)
  -a, --async         return without waiting (required in hooks)
  -q, --quiet         no status line

Sounds: ok error warn ask start notify

Examples
  nautice call
  nautice say "Build finished"
  nautice alert -t warn -n 3 "Disk is full"
  nautice play -V 0.3 ok
  nautice call -c both                  # sound + notification banner
  echo "pipes work too" | nautice say
USAGE
}

# ── Arguments ───────────────────────────────────────────────────────────────
OPT_VOICE='' OPT_VOL='' OPT_RATE='' OPT_TONE='' OPT_CHANNEL='' OPT_LANG=''
OPT_REPEAT=1 OPT_GAP=0.4 OPT_QUIET=0 OPT_ASYNC=0 OPT_HOLD=0 OPT_PLAN=0
CMD_NAME=''
REPEAT_GIVEN=0
ARGS=()

# Pin the accepted syntax (same as the ps1 side). awk alone would silently read
# "0,4" as 0 and "0.4abc" as 0.4 — a volume quietly becoming 0.
is_num() { [[ $1 =~ ^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)$ ]]; }
is_int() { [[ $1 =~ ^[+-]?[0-9]+$ ]]; }

# Range check in awk: (( )) rejects decimals and reads "08" as octal.
in_range() { awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN { exit !(v >= lo && v <= hi) }'; }

check_num() {
  local label=$1 v=$2 lo=$3 hi=$4
  is_num "$v" || die "$label must be a number: $v"
  in_range "$v" "$lo" "$hi" || die "$label must be between $lo and $hi: $v"
}

# --repeat must be an integer. A decimal would crash for (( )) here and be
# rounded by [int] on Windows — the same command breaking differently per OS.
check_int() {
  local label=$1 v=$2 lo=$3 hi=$4
  is_int "$v" || die "$label must be an integer: $v"
  in_range "$v" "$lo" "$hi" || die "$label must be between $lo and $hi: $v"
}

# Under set -u a missing option value dies as "unbound variable" at $2 — right
# exit code, but a bash internal error. Check first and fail with our message.
need_val() { (($# >= 2)) || die "$1 needs a value"; }

while (($#)); do
  case $1 in
    -v|--voice)  need_val "$@"; OPT_VOICE=$2; shift 2 ;;
    -V|--vol)    need_val "$@"; OPT_VOL=$2;   shift 2 ;;
    -r|--rate)   need_val "$@"; OPT_RATE=$2;  shift 2 ;;
    -t|--tone)   need_val "$@"; OPT_TONE=$2;  shift 2 ;;
    -c|--channel) need_val "$@"; OPT_CHANNEL=$2; shift 2 ;;
    -l|--lang)   need_val "$@"; OPT_LANG=$2;   shift 2 ;;
    -n|--repeat) need_val "$@"; OPT_REPEAT=$2; REPEAT_GIVEN=1; shift 2 ;;
    -g|--gap)    need_val "$@"; OPT_GAP=$2;   shift 2 ;;
    -a|--async)  OPT_ASYNC=1;  shift ;;
    -q|--quiet)  OPT_QUIET=1;  shift ;;
    --hold)      OPT_HOLD=1;   shift ;;
    --plan)      OPT_PLAN=1;   shift ;;
    -h|--help)   usage; exit 0 ;;
    --version)   echo "nautice $VERSION"; exit 0 ;;
    --)          shift; ARGS+=("$@"); break ;;
    -*)          die "unknown option: $1" ;;
    *)           ARGS+=("$1"); shift ;;
  esac
done
set -- "${ARGS[@]:-}"

[[ -n $OPT_VOL  ]] && check_num --vol  "$OPT_VOL"  0 10
[[ -n $OPT_RATE ]] && check_num --rate "$OPT_RATE" 0.1 10
check_int --repeat "$OPT_REPEAT" 1 20
check_num --gap    "$OPT_GAP"    0 10

LANG_REQ=${OPT_LANG:-$NAUTICE_LANG}
[[ $LANG_REQ == auto || $LANG_REQ =~ ^[a-z]{2}$ ]] \
  || die "--lang must be auto or a two-letter language code: $LANG_REQ"

CHANNEL=${OPT_CHANNEL:-$NAUTICE_CHANNEL}
case $CHANNEL in
  sound|visual|both) ;;
  *) die "--channel must be sound, visual or both: $CHANNEL" ;;
esac

# Hooks must not block the agent. Arguments are validated before detaching, so
# bad input still fails here with exit 1.
detach() {
  local args=("$1"); shift
  [[ -n $OPT_VOICE ]] && args+=(--voice "$OPT_VOICE")
  [[ -n $OPT_VOL   ]] && args+=(--vol   "$OPT_VOL")
  [[ -n $OPT_RATE  ]] && args+=(--rate  "$OPT_RATE")
  [[ -n $OPT_TONE  ]] && args+=(--tone  "$OPT_TONE")
  args+=(--channel "$CHANNEL")
  [[ -n $OPT_LANG ]] && args+=(--lang "$OPT_LANG")
  [[ $OPT_HOLD == 1 ]] && args+=(--hold)
  [[ $REPEAT_GIVEN == 1 ]] && args+=(--repeat "$OPT_REPEAT")
  args+=(--gap "$OPT_GAP" --quiet --)
  nohup "$0" "${args[@]}" "$@" >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

cmd=${1:-}; [[ $# -gt 0 ]] && shift
case $cmd in
  say|play|alert|call)
    check_num NAUTICE_PREROLL "$NAUTICE_PREROLL" 0 2
    if [[ $OPT_ASYNC == 1 ]]; then detach "$cmd" "$@"; exit 0; fi
    cache_prune "$VERSION"
    "cmd_$cmd" "$@" ;;
  list|doctor) cache_prune "$VERSION"; "cmd_$cmd" "$@" ;;
  cache|update) "cmd_$cmd" "$@" ;;
  ""|help) usage ;;
  *) die "unknown command: $cmd (nautice --help)" ;;
esac
