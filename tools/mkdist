#!/usr/bin/env python3
"""릴리스 자산을 dist/ 에 만든다. 표준 라이브러리만 쓴다.

계약은 docs/install.md 가 단일 출처다. 파일을 바이트 그대로 담는 것이 이
스크립트의 전부다 — nautice.ps1 의 UTF-8 BOM 과 CRLF, 그리고 .wav 가 인스톨러를
거치며 상하지 않게 하려고 아카이브를 쓴다.

내용은 고정된 mtime 으로 담는다. 같은 소스에서 같은 바이트가 나와야 올려 둔
SHA256SUMS 를 나중에 다시 확인할 수 있다.
"""
import gzip
import hashlib
import io
import re
import sys
import tarfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DIST = ROOT / "dist"

# 1980-01-01. zip 은 1980 이전을 담지 못한다.
MTIME = 315532800
ZIP_DATE = (1980, 1, 1, 0, 0, 0)

SOUNDS = sorted((ROOT / "share" / "sounds").glob("*.wav"))

# (아카이브 안 경로, 원본, 실행 권한)
COMMON = (
    [("bin/nautice", ROOT / "bin" / "nautice", True)]
    + [(f"share/nautice/sounds/{p.name}", p, False) for p in SOUNDS]
    + [("LICENSE", ROOT / "LICENSE", False)]
)
WINDOWS_ONLY = [
    ("bin/nautice.ps1", ROOT / "bin" / "nautice.ps1", False),
    ("bin/nautice.cmd", ROOT / "bin" / "nautice.cmd", False),
]


def version():
    """세 곳이 같은 값인지 보고 그 값을 돌려준다.

    어긋난 채로 자산을 만들면 태그와 알맹이가 다른 릴리스가 나간다.
    test/conformance 가 같은 것을 보지만 릴리스는 그것 없이도 돌 수 있다.

    encoding 을 빠뜨리면 안 된다. read_text() 의 기본값은 로캘 인코딩이라
    Windows 에서 cp1252 로 읽고, 주석의 한글에서 UnicodeDecodeError 로 죽는다.
    """
    found = {
        "bin/nautice": re.search(
            r"^VERSION=(.+)$",
            (ROOT / "bin" / "nautice").read_text(encoding="utf-8"),
            re.M,
        ),
        "bin/nautice.ps1": re.search(
            r"^\$VERSION = '(.+)'$",
            (ROOT / "bin" / "nautice.ps1").read_text(encoding="utf-8-sig"),
            re.M,
        ),
        "flake.nix": re.search(
            r'version = "([^"]+)"', (ROOT / "flake.nix").read_text(encoding="utf-8")
        ),
    }
    missing = [k for k, m in found.items() if not m]
    if missing:
        sys.exit(f"mkdist: 버전을 못 읽었다: {', '.join(missing)}")
    vals = {k: m.group(1) for k, m in found.items()}
    if len(set(vals.values())) != 1:
        detail = ", ".join(f"{k}={v}" for k, v in vals.items())
        sys.exit(f"mkdist: 버전이 세 곳에서 다르다 ({detail})")
    return next(iter(vals.values()))


def write_tar(path, root, entries):
    # tarfile 의 "w:gz" 를 쓰면 안 된다. gzip 헤더에 **현재 시각**과 원본 파일
    # 이름이 들어가서, 같은 소스로 두 번 만들어도 바이트가 달라진다. 1초 안에
    # 두 번 돌리면 같게 나와서 재현성을 확인했다고 착각하기 쉽다.
    with open(path, "wb") as raw:
        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as gz:
            with tarfile.open(fileobj=gz, mode="w", format=tarfile.GNU_FORMAT) as tar:
                for name, src, is_exec in entries:
                    data = src.read_bytes()
                    info = tarfile.TarInfo(f"{root}/{name}")
                    info.size = len(data)
                    info.mtime = MTIME
                    info.mode = 0o755 if is_exec else 0o644
                    info.uid = info.gid = 0
                    info.uname = info.gname = "root"
                    tar.addfile(info, io.BytesIO(data))


def write_zip(path, root, entries):
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
        for name, src, is_exec in entries:
            info = zipfile.ZipInfo(f"{root}/{name}", date_time=ZIP_DATE)
            info.compress_type = zipfile.ZIP_DEFLATED
            # 상위 16비트가 유닉스 권한이다. Git Bash 가 bin/nautice 를 바로
            # 실행할 수 있게 실행 비트를 남긴다.
            info.external_attr = (0o755 if is_exec else 0o644) << 16
            zf.writestr(info, src.read_bytes())


def main():
    if not SOUNDS:
        sys.exit("mkdist: share/sounds 에 .wav 가 없다 (tools/gen-sounds.py)")
    ver = version()
    root = f"nautice-{ver}"

    for name, src, _ in COMMON + WINDOWS_ONLY:
        if not src.is_file():
            sys.exit(f"mkdist: {src} 가 없다")

    DIST.mkdir(exist_ok=True)
    for stale in DIST.iterdir():
        stale.unlink()

    tar_path = DIST / "nautice-unix.tar.gz"
    zip_path = DIST / "nautice-windows.zip"
    write_tar(tar_path, root, COMMON)
    write_zip(zip_path, root, COMMON + WINDOWS_ONLY)

    lines = []
    for p in (tar_path, zip_path):
        digest = hashlib.sha256(p.read_bytes()).hexdigest()
        # sha256sum -c 와 shasum -a 256 -c 가 같이 읽는 서식이다.
        lines.append(f"{digest}  {p.name}\n")
        print(f"  {p.name:<24} {p.stat().st_size // 1024}K  {digest[:16]}…")
    # write_text 는 Windows 에서 \n 을 CRLF 로 바꾼다. 해시 파일의 바이트가
    # 만든 기계에 따라 달라지면 안 되므로 바이트로 쓴다.
    (DIST / "SHA256SUMS").write_bytes("".join(lines).encode())
    print(f"  {'SHA256SUMS':<24} {root}")


if __name__ == "__main__":
    main()
