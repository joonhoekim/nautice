#!/usr/bin/env bash
# Checks that both implementations keep the contract in docs/cli.md.
# Sound cannot be compared, so this compares what --plan prints. With only one
# implementation available, that one runs and comparisons are skipped.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
BASH_IMPL=bin/nautice
PS_IMPL=bin/nautice.ps1

# Fields that must match across OSes (voice and backend_* legitimately differ).
SHARED_FIELDS='^(command|voice_req|vol|rate|repeat|gap|tone|channel|hold|preroll|text|lang)='

pass=0 fail=0
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; pass=$((pass + 1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; shift; printf '       %s\n' "$@"; fail=$((fail + 1)); }

have_bash=0; [[ -x $BASH_IMPL ]] && have_bash=1
SKIP_WHY='only one implementation available'
# On Git Bash / MSYS, bin/nautice hands over to nautice.ps1: comparing would
# pit ps1 against itself, and the bash rate checks would fail on SAPI values.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    have_bash=0
    SKIP_WHY='Windows: bin/nautice hands over to ps1, nothing to compare' ;;
esac
have_ps=0
PWSH=""
if command -v pwsh >/dev/null 2>&1; then PWSH=pwsh
elif command -v powershell >/dev/null 2>&1; then PWSH=powershell
elif command -v nix >/dev/null 2>&1 && [[ ${NAUTICE_TEST_NIX_PWSH:-1} == 1 ]]; then
  # Borrow pwsh from nix when it is not installed.
  nix shell nixpkgs#powershell -c pwsh -NoProfile -Command 'exit 0' >/dev/null 2>&1 \
    && PWSH="nix-pwsh"
fi
[[ -n $PWSH && -f $PS_IMPL ]] && have_ps=1

run_bash() { "$BASH_IMPL" "$@" 2>&1; }
hash_file() { { sha1sum "$1" 2>/dev/null || shasum "$1"; } | cut -d' ' -f1; }
run_ps() {
  case $PWSH in
    nix-pwsh) nix shell nixpkgs#powershell -c pwsh -NoProfile -File "$PS_IMPL" "$@" 2>&1 ;;
    *)        "$PWSH" -NoProfile -File "$PS_IMPL" "$@" 2>&1 ;;
  esac
}

echo "conformance — bash=$have_bash ps=$have_ps${PWSH:+ ($PWSH)}"
echo

# ── Plan comparison ─────────────────────────────────────────────────────────
echo "Plans (OS-independent fields match)"
# --plan goes before the case's arguments: after a `--` it would be text, the
# command would really speak, and two empty plans would compare equal.
plan_case() {
  local name=$1; shift
  if (( have_bash == 0 || have_ps == 0 )); then
    printf '  \033[33mskip\033[0m %s (%s)\n' "$name" "$SKIP_WHY"; return
  fi
  local a b
  a=$(run_bash --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  b=$(run_ps   --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  if [[ -z $a || -z $b ]]; then
    bad "$name" "no plan printed (bash ${#a} chars, ps ${#b} chars)"
  elif [[ $a == "$b" ]]; then ok "$name"
  else bad "$name" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
}

plan_case 'say default'         say "test text"
plan_case 'say vol/rate'        say -V 0.4 -r 1.5 "test text"
plan_case 'say with voice'      say -v Heami "test text"
plan_case 'play by name'        play ok
plan_case 'play repeated'       play -n 3 -g 0.25 notify
plan_case 'alert with tone'     alert -t warn "Disk is full"
plan_case 'call twice by default' call
plan_case 'call with text'      call "Please check"
plan_case 'call repeat override' call -n 1 "Just once"
plan_case 'all text after --'   say -- "-v looks like an option"
# Language detection: a divergent lang means a different voice per OS.
plan_case 'Hangul is ko'        say "빌드가 끝났습니다"
plan_case 'English is en'       say "build finished"
# Accented Latin starts with C3; after a byte ending in e (n = 6E) a joined hex
# string shows a false "ec" (Hangul).
plan_case 'accented Latin is en' say "Renée finished the nüance"
plan_case 'mixed is ko'         say "build 가 끝났습니다"
# One case per script in docs/cli.md: bash reads UTF-8 bytes, Windows UTF-16
# ranges, so boundaries are where they can diverge.
plan_case 'lang Japanese'         say "ビルドが終わりました"
plan_case 'lang Chinese'         say "构建完成"
plan_case 'lang Russian'       say "Сборка завершена"
plan_case 'lang Greek'       say "Η κατασκευή ολοκληρώθηκε"
plan_case 'lang Arabic'         say "اكتمل البناء"
plan_case 'lang Hebrew'       say "הבנייה הושלמה"
plan_case 'lang Thai'         say "การสร้างเสร็จสิ้น"
plan_case 'lang Hindi'         say "बिल्ड पूरा हुआ"
# Kana plus Han is Japanese: table order decides.
plan_case 'kana+Han is ja' say "ビルド完了"
plan_case 'Hangul+Han is ko' say "빌드 完了"
plan_case '--lang wins'         say -l de "빌드가 끝났습니다"
plan_case '--lang long form'    say --lang ja "build finished"
# Channel: sound vs. banner must not depend on the OS.
plan_case 'channel default'     say "test text"
plan_case 'channel visual'      say -c visual "test text"
plan_case 'channel both'        alert -c both -t warn "Disk is full"
plan_case 'channel call both'   call --channel both
plan_case 'hold off by default' say -c visual "test text"
plan_case 'hold on'             say -c visual --hold "test text"
plan_case 'hold + both'         alert -c both --hold -t warn "Disk is full"
# With no banner there is nothing to hold: --hold is ignored, not rejected.
plan_case 'hold harmless with sound' say --hold "test text"
# Lead-in silence comes from the environment only; the default is 0.25.
NAUTICE_PREROLL=0   plan_case 'preroll off'  say "test text"
NAUTICE_PREROLL=1.5 plan_case 'preroll set'  play ok

# Text from a pipe. Windows must read stdin as UTF-8 itself; decoding with the
# console code page garbles Korean.
stdin_case() {
  local name=$1 text=$2; shift 2
  if (( have_bash == 0 || have_ps == 0 )); then
    printf '  \033[33mskip\033[0m %s (%s)\n' "$name" "$SKIP_WHY"; return
  fi
  local a b
  a=$(printf '%s' "$text" | run_bash --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  b=$(printf '%s' "$text" | run_ps   --plan "$@" | grep -E "$SHARED_FIELDS" | sort)
  if [[ -z $a || -z $b ]]; then
    bad "$name" "no plan printed (bash ${#a} chars, ps ${#b} chars)"
  elif [[ $a == "$b" ]]; then ok "$name"
  else bad "$name" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
}
stdin_case 'stdin Korean'       '빌드가 끝났습니다' say
stdin_case 'stdin English'      'build finished'    say
stdin_case 'stdin alert'        'Disk is full'      alert -t warn
echo

# ── Unit conversion ─────────────────────────────────────────────────────────
echo "Unit conversion (as in docs/cli.md)"
# No case inside $( ): bash 3.2 (macOS /bin/bash) fails on its ;; there.
check_rate() {
  local impl=$1 mult=$2 want=$3 got out
  if [[ $impl == bash ]]; then out=$(run_bash say --plan -r "$mult" x)
  else                        out=$(run_ps   say --plan -r "$mult" x)
  fi
  got=$(printf '%s\n' "$out" | sed -n 's/^backend_rate=//p')
  if [[ $got == "$want" ]]; then ok "$impl rate $mult -> $want"
  else bad "$impl rate $mult" "expected $want, got $got"; fi
}
if (( have_bash )); then
  # macOS / Linux: rate x 175 wpm
  for m in 0.5 1.0 1.5 2.0; do
    check_rate bash "$m" "$(awk -v m="$m" 'BEGIN { printf "%d", m * 175 }')"
  done
fi
if (( have_ps )); then
  # Windows: round(10 * log3(rate)), clamped to -10..10
  for m in 0.5 1.0 1.5 3.0; do
    check_rate ps "$m" "$(awk -v m="$m" 'BEGIN {
      r = 10 * log(m) / log(3)
      r = (r < 0) ? int(r - 0.5) : int(r + 0.5)
      if (r < -10) r = -10; if (r > 10) r = 10
      printf "%d", r }')"
  done
fi
echo

# ── Inputs that must be rejected ────────────────────────────────────────────
echo "Bad input exits 1 with our own message on both"
# The exit code alone would pass a .NET exception stack or bash's "unbound
# variable"; the first line must also be our own message.
reject_case() {
  local name=$1; shift
  local why='' rc msg
  if (( have_bash )); then
    msg=$(run_bash "$@" | head -1); rc=${PIPESTATUS[0]}
    (( rc == 1 ))            || why+="bash exit $rc; "
    [[ $msg == nautice:* ]]  || why+="bash message '${msg:-(none)}'; "
  fi
  if (( have_ps )); then
    msg=$(run_ps "$@" | head -1); rc=${PIPESTATUS[0]}
    (( rc == 1 ))            || why+="ps exit $rc; "
    [[ $msg == nautice:* ]]  || why+="ps message '${msg:-(none)}'; "
  fi
  if [[ -n $why ]]; then bad "$name" "$why"; else ok "$name"; fi
}
reject_case 'unknown option'   say --bogus x
reject_case 'unknown command'  bogus
# A checkout is not an installer-managed prefix; update must refuse, not overwrite it.
reject_case 'update from a checkout' update
reject_case 'cache bad argument' cache bogus
reject_case 'list bad argument'  list bogus
reject_case 'unknown sound'    play NoSuchSound
# --plan must resolve sounds too, or a typo in a hook goes unnoticed.
reject_case 'unknown sound --plan' play NoSuchSound --plan
reject_case 'unknown tone'     alert -t NoSuchTone x
reject_case 'unknown channel'  say -c bogus x
reject_case 'unknown language' say -l xyz x
reject_case 'missing -l value' say -l
# A sound has no text to put in a banner.
reject_case 'play with visual' play -c visual ok
reject_case 'play with both'   play -c both ok
reject_case '--repeat range'   say -n 99 x
reject_case '--gap range'      say -g 99 x
reject_case '--rate range'     say -r 0 x
reject_case 'play without args' play
# Missing values and non-numbers must fail with our message, not an internal error.
reject_case 'missing -v value' say -v
reject_case 'missing -V value' say -V
reject_case 'missing -r value' say -r
reject_case 'missing -n value' say -n
reject_case 'missing -g value' say -g
reject_case 'missing -t value' say -t
reject_case 'missing -c value' say -c
reject_case '--vol letters'    say -V xyz x
reject_case '--rate letters'   say -r abc x
reject_case '--repeat letters' say -n q x
# A decimal would crash bash's arithmetic and be rounded by PowerShell.
reject_case '--repeat decimal' say -n 2.7 x
# Comma decimals and trailing junk must not slip through as some number.
reject_case '--vol comma'      say -V 0,4 x
reject_case '--vol trailing'   say -V 0.4abc x
NAUTICE_PREROLL=abc reject_case 'NAUTICE_PREROLL letters' say x
NAUTICE_PREROLL=3   reject_case 'NAUTICE_PREROLL range'   play ok
# Checked before detaching, or a hook would lose every notification silently.
NAUTICE_PREROLL=abc reject_case 'NAUTICE_PREROLL with --async' say -a x
echo

# ── Help lists every contract option ────────────────────────────────────────
echo "Help lists every contract option"
for opt in --voice --lang --vol --rate --tone --channel --hold --repeat --gap --async --quiet; do
  miss=""
  (( have_bash )) && ! run_bash --help | grep -q -- "$opt" && miss="bash"
  (( have_ps ))   && ! run_ps   --help | grep -q -- "$opt" && miss="${miss:+$miss, }ps"
  if [[ -n $miss ]]; then bad "$opt" "missing in: $miss"; else ok "$opt"; fi
done
echo

# ── doctor and list ─────────────────────────────────────────────────────────
echo "doctor and list follow the contract"
# doctor's exit code depends on what is installed, so only the header line —
# version and backend — is checked.
doctor_head='^nautice [0-9]+\.[0-9]+\.[0-9]+ \((macos|linux|windows)\)$'
if (( have_bash )); then
  got=$(run_bash doctor | head -1)
  if [[ $got =~ $doctor_head ]]; then ok "bash doctor header"
  else bad "bash doctor header" "'$got'"; fi
fi
if (( have_ps )); then
  got=$(run_ps doctor | head -1)
  if [[ $got =~ $doctor_head ]]; then ok "ps doctor header"
  else bad "ps doctor header" "'$got'"; fi
fi
# The defaults line must format numbers alike; label padding differs, so only
# the numbers are compared.
defaults_of() { sed -n 's/^.*\(vol=[0-9.]* rate=[0-9.]*\).*$/\1/p'; }
if (( have_bash && have_ps )); then
  a=$(run_bash doctor | defaults_of)
  b=$(run_ps   doctor | defaults_of)
  if [[ $a == "$b" && -n $a ]]; then ok "doctor defaults ($a)"
  else bad "doctor defaults" "bash '$a' / ps '$b'"; fi
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "doctor defaults" "$SKIP_WHY"
fi
# Bundled tone names must match on every OS; OS system sounds are excluded.
bundled() { sed -n '/^Bundled/,/^$/p' | sed -n 's/^  //p' | sort; }
if (( have_bash && have_ps )); then
  a=$(run_bash list sounds | bundled)
  b=$(run_ps   list sounds | bundled)
  if [[ $a == "$b" && -n $a ]]; then ok "list sounds: bundled names"
  else bad "list sounds: bundled names" "$(diff <(printf '%s\n' "$a") <(printf '%s\n' "$b") | head -8)"; fi
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "list sounds: bundled names" "$SKIP_WHY"
fi
echo

# ── Cache belongs to one version ────────────────────────────────────────────
# Voice choices cached by an older version would otherwise outlive an upgrade.
# Pruning must keep files nautice did not write: NAUTICE_CACHE can be shared.
echo "Cache belongs to one version (bash side)"
if (( have_bash )); then
  c=$(mktemp -d)
  printf 'Stale\ten\n' > "$c/.voices"; printf 'Stale' > "$c/.voice-en"
  mkdir "$c/0.0.1"; touch "$c/0123456789abcdef0123456789abcdef01234567.aiff" "$c/keep.wav" "$c/notes.txt"
  ver=$(sed -n 's/^VERSION=//p' "$BASH_IMPL")
  entries() { find "$c" -mindepth 1 -maxdepth 1 ! -name "$ver" ! -name .lock -exec basename {} \; | sort | tr '\n' ' '; }
  NAUTICE_CACHE=$c run_bash say --plan x >/dev/null
  left=$(entries)
  if [[ $left == "keep.wav notes.txt " ]]; then ok "old version's cache pruned, other files kept"
  else bad "cache prune" "left: $left"; fi
  NAUTICE_CACHE=$c run_bash cache clear >/dev/null
  left=$(find "$c" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort | tr '\n' ' ')
  if [[ $left == "keep.wav notes.txt " ]]; then ok "cache clear removes only its own files"
  else bad "cache clear" "left: $left"; fi
  rm -rf "$c"
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "cache" "$SKIP_WHY"
fi
echo

# ── Linux voices ────────────────────────────────────────────────────────────
# espeak-ng lacks some locales' languages (gl, tl) and exits 1 for them; under
# --async that loses every notification silently. A stub stands in for
# espeak-ng so this runs where it is not installed.
echo "Linux voices (bash side)"
if (( have_bash )) && [[ $(uname -s) == Linux ]]; then
  c=$(mktemp -d)
  mkdir "$c/bin"
  cat > "$c/bin/espeak-ng" <<'STUB'
#!/bin/sh
cat <<'V'
Pty Language       Age/Gender VoiceName          File                 Other Languages
 5  af              --/M      Afrikaans          gmw/af
 5  chr-US-Qaaa-x-west --/M      Cherokee_          iro/chr
 5  cmn             --/M      Chinese_(Mandarin,_latin_as_English) sit/cmn              (zh-cmn 5)(zh 5)
 2  en-us           --/M      English_(America)  gmw/en-US            (en 3)
 5  nb              --/M      Norwegian_Bokmål  gmq/nb               (no 5)
V
STUB
  chmod +x "$c/bin/espeak-ng"
  voice_of() { NAUTICE_CACHE=$c/cache PATH=$c/bin:$PATH run_bash --plan say "$@" | sed -n 's/^voice=//p'; }
  got=$(voice_of -l gl "Ola")
  if [[ $got == en ]]; then ok "language without a voice falls back to en"
  else bad "no-voice fallback" "voice '$got', want en"; fi
  got=$(voice_of "构建完成")
  if [[ $got == zh ]]; then ok "zh found through espeak-ng's alias"
  else bad "zh alias" "voice '$got', want zh"; fi
  got=$(NAUTICE_CACHE=$c/cache PATH=$c/bin:$PATH run_bash list voices | sed -n 's/^  //p' | sort -u | tr '\n' ' ')
  if [[ $got == "af cmn en-us iro/chr nb " ]]; then ok "list voices shows names -v accepts"
  else bad "list voices" "'$got'"; fi
  # The cache now holds a voice table; without espeak-ng it must not be shown.
  # espeak-ng may sit next to these tools in /usr/bin, so the PATH holds only them.
  mkdir "$c/min"
  for t in bash uname dirname readlink awk sed od tr grep cut sort find wc du mkdir cat rm rmdir head; do
    ln -s "$(command -v "$t")" "$c/min/$t"
  done
  got=$(NAUTICE_CACHE=$c/cache PATH=$c/min run_bash doctor | sed -n 's/^  languages *//p')
  if [[ -z ${got// } ]]; then ok "doctor lists no languages without espeak-ng"
  else bad "doctor languages" "'$got' from a stale cache"; fi
  rm -rf "$c"
else
  printf '  \033[33mskip\033[0m %s\n' "Linux voices (not Linux)"
fi
echo

# ── TTS command ─────────────────────────────────────────────────────────────
# A user command renders speech on the bash side. It must get the text and
# language, and a failing one must fall back, not lose the notification. Stubs
# stand in for the player and espeak-ng; what reached the player is compared.
echo "TTS command (bash side)"
if (( have_bash )); then
  c=$(mktemp -d); mkdir "$c/bin"
  for p in pw-play afplay; do
    # shellcheck disable=SC2016  # $a and $f belong to the stub
    printf '#!/bin/sh\nfor a; do f=$a; done; cp "$f" "%s/played.wav"\n' "$c" > "$c/bin/$p"
    chmod +x "$c/bin/$p"
  done
  # A fallback that is not the command's output: warn.wav instead of ok.wav.
  cat > "$c/bin/espeak-ng" <<STUB
#!/bin/sh
case "\$1" in --voices) printf 'Pty Language Age/Gender VoiceName File Other\\n 2 en --/M English gmw/en\\n'; exit ;; esac
while [ \$# -gt 0 ]; do [ "\$1" = -w ] && cp "$PWD/share/sounds/warn.wav" "\$2"; shift; done
STUB
  chmod +x "$c/bin/espeak-ng"
  tts() { NAUTICE_CACHE=$c/cache NAUTICE_PREROLL=0 PATH=$c/bin:$PATH run_bash "$@"; }
  backend_of() { tts --plan "$@" | sed -n 's/^backend_tts=//p'; }

  got=$(NAUTICE_TTS_CMD_KO=x NAUTICE_TTS_CMD=y backend_of say "빌드 끝")
  if [[ $got == NAUTICE_TTS_CMD_KO ]]; then ok "per-language command wins"
  else bad "per-language command" "backend_tts '$got'"; fi
  got=$(NAUTICE_TTS_CMD_KO=x NAUTICE_TTS_CMD=y backend_of say "build done")
  if [[ $got == NAUTICE_TTS_CMD ]]; then ok "other languages use NAUTICE_TTS_CMD"
  else bad "NAUTICE_TTS_CMD" "backend_tts '$got'"; fi
  got=$(NAUTICE_TTS_CMD_KO=x backend_of say "build done")
  if [[ -n $got && $got != NAUTICE_TTS_CMD* ]]; then ok "no command for the language: built-in ($got)"
  else bad "built-in engine" "backend_tts '$got'"; fi

  # shellcheck disable=SC2016  # expanded by the command's sh, not here
  cmd='cat > "'$c'/in.txt"; echo "$NAUTICE_TTS_LANG $NAUTICE_TTS_RATE" > "'$c'/env.txt"
       echo run >> "'$c'/runs"; cp share/sounds/ok.wav "$NAUTICE_TTS_OUT"'
  NAUTICE_TTS_CMD_KO=$cmd tts -q say -r 1.5 "빌드 끝" >/dev/null
  if [[ $(hash_file "$c/played.wav" 2>/dev/null) == "$(hash_file share/sounds/ok.wav)" ]]
  then ok "the command's WAV is played"; else bad "command WAV" "the player got something else"; fi
  if [[ $(cat "$c/in.txt" 2>/dev/null) == "빌드 끝" && $(cat "$c/env.txt" 2>/dev/null) == "ko 1.5" ]]
  then ok "text on stdin, language and rate in the environment"
  else bad "command input" "stdin '$(cat "$c/in.txt" 2>/dev/null)', env '$(cat "$c/env.txt" 2>/dev/null)'"; fi
  NAUTICE_TTS_CMD_KO=$cmd tts -q say -r 1.5 "빌드 끝" >/dev/null
  if [[ $(wc -l < "$c/runs") -eq 1 ]]; then ok "a cached render does not run the command again"
  else bad "command cache" "ran $(wc -l < "$c/runs") times"; fi

  if [[ $(uname -s) == Linux ]]; then
    for bad_cmd in 'exit 3' 'true' ; do
      rm -f "$c/played.wav"
      err=$(NAUTICE_TTS_CMD_KO=$bad_cmd NAUTICE_CACHE=$c/cache NAUTICE_PREROLL=0 PATH=$c/bin:$PATH \
        "$BASH_IMPL" -q say "빌드 실패" 2>&1 >/dev/null); rc=$?
      if (( rc == 0 )) && [[ $err == *"NAUTICE_TTS_CMD_KO failed"* ]] \
         && [[ $(hash_file "$c/played.wav" 2>/dev/null) == "$(hash_file share/sounds/warn.wav)" ]]
      then ok "'$bad_cmd' falls back to espeak-ng"
      else bad "fallback from '$bad_cmd'" "exit $rc, stderr '$err'"; fi
    done
  fi
  rm -rf "$c"
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "TTS command" "$SKIP_WHY"
fi
echo

# ── Installed layout beside a sound theme ───────────────────────────────────
# <prefix>/share/sounds is the XDG sound theme directory (~/.local on most
# desktops); taking it for the bundle made every sound "no such sound".
echo "Installed layout finds its sounds beside a sound theme"
c=$(mktemp -d)
mkdir -p "$c/bin" "$c/share/sounds/freedesktop" "$c/share/nautice/sounds"
cp "$BASH_IMPL" "$PS_IMPL" "$c/bin/"
cp share/sounds/*.wav "$c/share/nautice/sounds/"
if (( have_bash )); then
  if "$c/bin/nautice" play --plan ok >/dev/null 2>&1; then ok "bash finds share/nautice/sounds"
  else bad "bash sound dir" "$("$c/bin/nautice" play --plan ok 2>&1 | head -1)"; fi
fi
if (( have_ps )); then
  PS_IMPL=$c/bin/nautice.ps1
  if run_ps play --plan ok | grep -q '^command=play'; then ok "ps finds share/nautice/sounds"
  else bad "ps sound dir" "$(run_ps play --plan ok | head -1)"; fi
  PS_IMPL=bin/nautice.ps1
fi
rm -rf "$c"
echo

# ── Lead-in silence is spliced alike ────────────────────────────────────────
# Both sides rewrite WAV headers with their own parser; a size off by one byte
# plays on one OS and fails or clicks on the other. The bash side's output is
# caught with a stub player, the ps1 function is loaded on its own.
echo "Lead-in silence is spliced alike"
if (( have_bash && have_ps )); then
  c=$(mktemp -d); mkdir "$c/bin"
  for p in pw-play afplay; do
    # shellcheck disable=SC2016  # $a and $f belong to the stub
    printf '#!/bin/sh\nfor a; do f=$a; done; cp "$f" "%s/bash.wav"\n' "$c" > "$c/bin/$p"
    chmod +x "$c/bin/$p"
  done
  cat > "$c/lead.ps1" <<'PS'
param($in, $out)
$src = Get-Content -Raw bin/nautice.ps1
. ([ScriptBlock]::Create([regex]::Match($src, '(?ms)^function Add-WavLead.*?^}').Value))
[IO.File]::WriteAllBytes($out, (Add-WavLead ([IO.File]::ReadAllBytes((Resolve-Path $in))) 250))
PS
  NAUTICE_CACHE=$c/cache NAUTICE_PREROLL=0.25 PATH=$c/bin:$PATH run_bash -q play ok >/dev/null
  case $PWSH in
    nix-pwsh) nix shell nixpkgs#powershell -c pwsh -NoProfile -File "$c/lead.ps1" share/sounds/ok.wav "$c/ps.wav" ;;
    *)        "$PWSH" -NoProfile -File "$c/lead.ps1" share/sounds/ok.wav "$c/ps.wav" ;;
  esac
  a=$(hash_file "$c/bash.wav") b=$(hash_file "$c/ps.wav") o=$(hash_file share/sounds/ok.wav)
  if [[ -n $a && $a == "$b" && $a != "$o" ]]; then ok "ok.wav with 250 ms: same bytes on both"
  else bad "lead-in bytes" "bash ${a:-(none)} / ps ${b:-(none)} / original $o"; fi
  rm -rf "$c"
else
  printf '  \033[33mskip\033[0m %s (%s)\n' "lead-in bytes" "$SKIP_WHY"
fi
echo

# ── install.ps1 is plain ASCII ──────────────────────────────────────────────
# It is piped through irm from an octet-stream release asset with no charset;
# a BOM or any byte >= 0x80 may be decoded differently by PowerShell 5.1.
echo "install.ps1 is ASCII without a BOM"
high=$(od -An -tx1 -v install.ps1 | tr ' ' '\n' | grep -cE '^[89a-f][0-9a-f]$')
if (( high == 0 )); then ok "install.ps1 is ASCII"
else bad "install.ps1" "$high bytes >= 0x80 (BOM or non-ASCII)"; fi
echo

# ── Version ─────────────────────────────────────────────────────────────────
# The version lives in three files; bumping one splits --version from the nix
# package. Read from files, so all three are checked on any machine.
echo "Version is the same in all three places"
v_nix=$(sed -n 's/.*version = "\([^"]*\)".*/\1/p' flake.nix | head -1)
v_bash=$(sed -n 's/^VERSION=//p' "$BASH_IMPL")
v_ps=$(tr -d '\r' < "$PS_IMPL" | sed -n "s/^\$VERSION = '\(.*\)'$/\1/p")
for pair in "flake.nix:$v_nix" "bin/nautice:$v_bash" "bin/nautice.ps1:$v_ps"; do
  where=${pair%%:*} got=${pair#*:}
  if [[ -z $got ]]; then bad "$where" "cannot read the version"
  elif [[ $got == "$v_nix" ]]; then ok "$where $got"
  else bad "$where" "flake.nix has $v_nix, $where has $got"; fi
done
# And --version must actually print it.
if (( have_bash )); then
  got=$(run_bash --version)
  if [[ $got == "nautice $v_bash" ]]; then ok "bash --version"
  else bad "bash --version" "expected 'nautice $v_bash', got '$got'"; fi
fi
if (( have_ps )); then
  got=$(run_ps --version)
  if [[ $got == "nautice $v_ps" ]]; then ok "ps --version"
  else bad "ps --version" "expected 'nautice $v_ps', got '$got'"; fi
fi

# docs/cli.md states call's default message verbatim; code and doc must agree.
if (( have_bash || have_ps )); then
  # shellcheck disable=SC2016  # the pattern matches literal Markdown backticks
  doc_call=$(sed -n 's/^`call` speaks `\([^`]*\)` by default.*$/\1/p' docs/cli.md | head -1)
  if (( have_bash )); then got=$(run_bash call --plan | sed -n 's/^text=//p')
  else                      got=$(run_ps   call --plan | sed -n 's/^text=//p'); fi
  if [[ -n $doc_call && $doc_call == "$got" ]]; then ok "call default text ($got)"
  else bad 'call default text' "docs/cli.md says '${doc_call:-(unreadable)}', implementation says '$got'"; fi
fi

# The README's agent prompt names options. A renamed option would have agents
# write broken config, noticed only afterwards.
echo "Options named in the README agent prompt exist"
readme_opts=$(sed -n '/^## Wiring it to an agent/,/^## Layout/p' README.md \
  | grep -oE '`--?[a-z][a-z-]*' | tr -d '`' | sort -u)
[[ -n $readme_opts ]] || bad 'README prompt' 'no options found (was the section renamed?)'
for opt in $readme_opts; do
  miss=""
  (( have_bash )) && ! run_bash --help | grep -q -- "$opt" && miss="bash"
  (( have_ps ))   && ! run_ps   --help | grep -q -- "$opt" && miss="${miss:+$miss, }ps"
  if [[ -n $miss ]]; then bad "README $opt" "not in help: $miss"; else ok "README $opt"; fi
done
echo

# ── Contract tone names exist in the bundle ─────────────────────────────────
# A tone named in docs/cli.md but never generated fails at runtime; a file
# nobody documents is never found.
echo "Contract sound names match the bundled files"
# shellcheck disable=SC2016  # the pattern matches literal Markdown backticks
doc_tones=$(grep -F 'share/sounds/<name>.wav' docs/cli.md | grep -oE '`[a-z]+`' | tr -d '`' | sort)
wav_tones=$(find share/sounds -name '*.wav' -exec basename {} .wav \; | sort)
if [[ $doc_tones == "$wav_tones" && -n $doc_tones ]]; then
  ok "$(printf '%s' "$doc_tones" | tr '\n' ' ')"
else
  bad 'sound names' "$(diff <(printf '%s\n' "$doc_tones") <(printf '%s\n' "$wav_tones") | head -8)"
fi
echo

# ── Contract documents every environment variable ───────────────────────────
# An undocumented variable is undiscoverable. Reads files only, so it runs anywhere.
echo "Contract documents every environment variable"
impl_envs=$(grep -ohE 'NAUTICE_[A-Z_]+' "$BASH_IMPL" "$PS_IMPL" | sort -u)
# docs/cli.md may also mention installer variables (update passes them through).
readers=$(grep -ohE 'NAUTICE_[A-Z_]+' "$BASH_IMPL" "$PS_IMPL" install.sh install.ps1 | sort -u)
doc_envs=$(grep -ohE 'NAUTICE_[A-Z_]+' docs/cli.md | sort -u)
for v in $impl_envs; do
  if grep -qF "$v" docs/cli.md; then ok "$v"; else bad "$v" "read by an implementation but missing from docs/cli.md"; fi
done
# Names like NAUTICE_VOICE_KO are assembled at runtime; the source only has the
# NAUTICE_VOICE_ prefix, so documented names under it count as covered.
for v in $doc_envs; do
  covered=0
  for i in $readers; do
    if [[ $v == "$i" ]] || [[ $i == *_ && $v == "$i"* ]]; then covered=1; break; fi
  done
  (( covered )) || bad "$v" "in docs/cli.md but read by no implementation"
done
echo

printf '%d passed, %d failed\n' "$pass" "$fail"
(( fail == 0 ))
