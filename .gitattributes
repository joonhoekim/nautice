# Windows 실행 파일은 CRLF, POSIX 스크립트는 LF 로 고정한다.
# nautice.ps1 은 UTF-8 BOM 이어야 한글 문구가 PowerShell 5.1 에서 깨지지 않는다.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
bin/nautice text eol=lf
test/*      text eol=lf
*.md        text eol=lf
*.nix       text eol=lf
*.py        text eol=lf
install.sh  text eol=lf
tools/*     text eol=lf
*.wav       binary
